diff --git a/Source/JavaScriptCore/CMakeLists.txt b/Source/JavaScriptCore/CMakeLists.txt
index b52d88928..7696b071c 100644
--- a/Source/JavaScriptCore/CMakeLists.txt
+++ b/Source/JavaScriptCore/CMakeLists.txt
@@ -407,6 +407,14 @@ set(LLIntSettingsExtractor_FRAMEWORKS ${JavaScriptCore_FRAMEWORKS})
 set(LLIntSettingsExtractor_DEPENDENCIES JavaScriptCore_CopyHeaders)
 WEBKIT_EXECUTABLE(LLIntSettingsExtractor)
 
+# This tool is never executed: generate_offset_extractor.rb only scans its
+# bytes for the settings table. A PlayStation executable has no _start, so
+# --gc-sections would drop that table as unreachable. Keep the tool's main
+# alive to keep the table in the file.
+if (CMAKE_SYSTEM_NAME STREQUAL "PlayStation")
+    target_link_options(LLIntSettingsExtractor PRIVATE "-Wl,-u,main")
+endif ()
+
 # LLIntSettingsExtractor target needs to have a direct or indirect
 # dependency to Bytecodes target for CMake Visual Studio generator to
 # eliminate duplicated custom commands. Otherwise, Bytecodes.h will be
@@ -426,6 +434,12 @@ set(LLIntOffsetsExtractor_FRAMEWORKS ${JavaScriptCore_FRAMEWORKS})
 set(LLIntOffsetsExtractor_DEPENDENCIES JavaScriptCore_CopyHeaders JSCBuiltins)
 WEBKIT_EXECUTABLE(LLIntOffsetsExtractor)
 
+# Same reason as LLIntSettingsExtractor above: asm.rb only scans this binary
+# for magic values, and --gc-sections would drop them for lack of _start.
+if (CMAKE_SYSTEM_NAME STREQUAL "PlayStation")
+    target_link_options(LLIntOffsetsExtractor PRIVATE "-Wl,-u,main")
+endif ()
+
 # The build system will execute asm.rb every time LLIntOffsetsExtractor's mtime is newer than
 # LLIntAssembly.h's mtime. The problem we have here is: asm.rb has some built-in optimization
 # that generates a checksum of the LLIntOffsetsExtractor binary, if the checksum of the new
